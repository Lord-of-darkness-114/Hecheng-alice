@echo off
chcp 65001 >nul
cd /d "%~dp0"
title 推送到 GitHub（推完再关这个窗口）

echo ============================================================
echo   把「完整源码 + publish 成品」推送到 GitHub
echo ============================================================
echo.
echo   仓库地址：https://github.com/Lord-of-darkness-114/-
echo   要上传：116 个文件，约 10 MB
echo.
echo   ------------------------------------------------------------
echo   【接下来会发生什么】
echo   ------------------------------------------------------------
echo   1. 马上会弹出一个小窗口要你登录 GitHub
echo      （装在你电脑里的 Git 凭据助手自动弹的）——
echo      点一下授权就行，授权过一次以后就不用再登了。
echo.
echo   2. 然后开始上传。国内网速大概要 1~5 分钟，
echo      进度条可能会卡住不动一下，那是正常的，别关窗口。
echo.
echo   3. 看到 "main -> main" 这种字样就是成功了。
echo.
echo   注意：如果它不弹窗、而是让你输用户名和密码，
echo         GitHub 早就不用密码了 —— 需要去 GitHub 网站建一个
echo         "Personal access token"，把它当密码粘贴进来。
echo         卡住就把这个窗口截图发给助手。
echo.
echo ============================================================
pause

echo.
echo   正在推送，请稍等...
echo.
git push -u origin main

echo.
if errorlevel 1 (
  echo ============================================================
  echo   [失败] 上面就是错误信息（多半是橙红色）
  echo   把这个窗口里的内容截图发给助手，我帮你看。
  echo ============================================================
) else (
  echo ============================================================
  echo   [成功] 去这里看你的仓库：
  echo          https://github.com/Lord-of-darkness-114/-
  echo.
  echo   想开 GitHub Pages（网页版游戏地址）的话，
  echo   回到对话里告诉助手，我教你下一步。
  echo ============================================================
)
echo.
echo 按任意键关闭窗口。
pause >nul
